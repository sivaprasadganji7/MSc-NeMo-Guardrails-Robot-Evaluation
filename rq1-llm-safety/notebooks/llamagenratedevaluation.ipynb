        "%cd SafeDialBench-Dataset\n",
        "\n",
        "# Install FastChat\n",
        "%cd FastChat\n",
        "!pip install -e \".[model_worker,llm_judge]\" -q\n",
        "\n",
        "print(\"\\nInstallation complete!\")"
