      "source": [
        "import json, os, shutil, time, subprocess\n",
        "\n",
        "judge_path = \"/content/SafeDialBench-Dataset/FastChat/fastchat/llm_judge/data/SafeDial_bench/model_judgment/gpt-3.5-turbo_Llama3.1-8B-Instruct_en.jsonl\"\n",
        "question_path = \"/content/SafeDialBench-Dataset/FastChat/fastchat/llm_judge/data/SafeDial_bench/question_en.jsonl\"\n",
        "work_dir = \"/content/SafeDialBench-Dataset/FastChat/fastchat/llm_judge\"\n",
        "backup_dir = \"/content/drive/MyDrive/SafeDialBench_results\"\n",
        "os.makedirs(backup_dir, exist_ok=True)\n",
        "\n",
        "def get_judged_ids():\n",
        "    if not os.path.exists(judge_path):\n",
        "        return set()\n",
        "    seen = set()\n",
        "    with open(judge_path) as f:\n",
        "        for line in f:\n",
        "            if line.strip():\n",
        "                r = json.loads(line)\n",
        "                seen.add(r.get(\"question_id\") or r.get(\"id\"))\n",
        "    return seen\n",
        "\n",
        "def get_all_ids():\n",
        "    ids = []\n",
        "    with open(question_path) as f:\n",
        "        for line in f:\n",
        "            if line.strip():\n",
        "                r = json.loads(line)\n",
        "                ids.append(r.get(\"id\"))\n",
        "    return ids\n",
        "\n",
        "def dedup_now():\n",
        "    seen = set()\n",
        "    clean = []\n",
        "    with open(judge_path) as f:\n",
        "        for line in f:\n",
        "            if not line.strip(): continue\n",
        "            r = json.loads(line)\n",
        "            rid = r.get(\"question_id\") or r.get(\"id\")\n",
        "            if rid not in seen:\n",
        "                seen.add(rid)\n",
        "                clean.append(line)\n",
        "    with open(judge_path, \"w\") as f:\n",
        "        f.writelines(clean)\n",
        "    return len(clean)\n",
        "\n",
        "def backup(label):\n",
        "    shutil.copy(judge_path, os.path.join(backup_dir, f\"judgment_{label}.jsonl\"))\n",
        "    shutil.copy(judge_path, os.path.join(backup_dir, \"judgment_LATEST.jsonl\"))\n",
        "    print(f\"✅ Backed up: {label}\")\n",
        "\n",
        "def write_temp_questions(ids_to_judge):\n",
        "    \"\"\"Write only unjudged questions to a temp file\"\"\"\n",
        "    temp_path = \"/content/SafeDialBench-Dataset/FastChat/fastchat/llm_judge/data/SafeDial_bench/question_temp.jsonl\"\n",
        "    all_questions = {}\n",
        "    with open(question_path) as f:\n",
        "        for line in f:\n",
        "            if line.strip():\n",
        "                r = json.loads(line)\n",
        "                all_questions[r[\"id\"]] = r\n",
        "\n",
        "    with open(temp_path, \"w\") as f:\n",
        "        for qid in ids_to_judge:\n",
        "            if qid in all_questions:\n",
        "                f.write(json.dumps(all_questions[qid]) + \"\\n\")\n",
        "\n",
        "    return temp_path, len(ids_to_judge)\n",
        "\n",
        "# --- Config ---\n",
        "total_questions = 2037\n",
        "batch_size = 50\n",
        "batch_num = 0\n",
        "\n",
        "all_ids = get_all_ids()\n",
        "print(f\"Total questions: {len(all_ids)}\")\n",
        "\n",
        "# --- Main loop ---\n",
        "while True:\n",
        "    judged_ids = get_judged_ids()\n",
        "    done = len(judged_ids)\n",
        "\n",
        "    print(f\"\\n[Batch {batch_num+1}] Judged: {done} / {total_questions}\")\n",
        "\n",
        "    if done >= total_questions:\n",
        "        print(\"\\n🎉 All done!\")\n",
        "        backup(f\"FINAL_{done}records\")\n",
        "        break\n",
        "\n",
        "    # Get ONLY unjudged IDs for this batch\n",
        "    unjudged = [qid for qid in all_ids if qid not in judged_ids]\n",
        "    batch_ids = unjudged[:batch_size]\n",
        "\n",
        "    print(f\"Judging IDs: {batch_ids[0]} to {batch_ids[-1]}\")\n",
        "\n",
        "    # Patch gen_judgment to only run these IDs\n",
        "    # Write them to a temp question file\n",
        "    temp_path, count = write_temp_questions(batch_ids)\n",
        "    print(f\"Temp question file written: {count} questions\")\n",
        "\n",
        "    # Run judgment on temp file\n",
        "    result = subprocess.run(\n",
        "        [\"python\", \"gen_judgment.py\",\n",
        "         \"--bench-name\", \"SafeDial_bench\",\n",
        "         \"--judge-model\", \"gpt-3.5-turbo\",\n",
        "         \"--model-list\", \"Llama3.1-8B-Instruct\",\n",
        "         \"--mode\", \"single\",\n",
        "         \"--parallel\", \"2\",\n",
        "         \"--first-n\", str(batch_size)],  # only batch_size questions in temp file\n",
        "        cwd=work_dir,\n",
        "        env={**os.environ, \"SAFEDIAL_QUESTION_FILE\": temp_path}\n",
        "    )\n",
        "\n",
        "    # Dedup after every batch\n",
        "    count = dedup_now()\n",
        "    batch_num += 1\n",
        "\n",
        "    print(f\"After dedup: {count} unique records\")\n",
        "    pct = (count / total_questions) * 100\n",
        "    print(f\"Progress: {pct:.1f}%\")\n",
        "\n",
        "    if batch_num % 5 == 0:\n",
        "        backup(f\"batch{batch_num}_{count}records\")\n",
        "\n",
        "    time.sleep(25)"
      ],
