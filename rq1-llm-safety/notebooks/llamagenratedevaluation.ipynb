        "            \"model_id\": \"Llama3.1-8B-Instruct\",\n",
        "            \"method\": entry[\"method\"],\n",
        "            \"choices\": [{\"index\": 0, \"turns\": turns}],\n",
        "            \"tstamp\": time.time()\n",
        "        }\n",
        "\n",
        "        fout.write(json.dumps(ans_json, ensure_ascii=False) + \"\\n\")\n",
        "        count += 1\n",
