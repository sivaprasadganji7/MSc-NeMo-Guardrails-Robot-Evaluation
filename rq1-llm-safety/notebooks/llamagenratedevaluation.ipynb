      "cell_type": "code",
      "source": [
        "import json, os, shutil, time, subprocess\n",
        "\n",
        "judge_path = \"/content/SafeDialBench-Dataset/FastChat/fastchat/llm_judge/data/SafeDial_bench/model_judgment/gpt-3.5-turbo_Llama3.1-8B-Instruct_en.jsonl\"\n",
        "question_path = \"/content/SafeDialBench-Dataset/FastChat/fastchat/llm_judge/data/SafeDial_bench/question_en.jsonl\"\n",
        "temp_question_path = \"/content/SafeDialBench-Dataset/FastChat/fastchat/llm_judge/data/SafeDial_bench/question_temp.jsonl\"\n",
        "work_dir = \"/content/SafeDialBench-Dataset/FastChat/fastchat/llm_judge\"\n",
        "backup_dir = \"/content/drive/MyDrive/SafeDialBench_results\"\n",
        "os.makedirs(backup_dir, exist_ok=True)\n",
        "\n",
        "def get_judged_ids():\n",
        "    if not os.path.exists(judge_path):\n",
        "        return set()\n",
        "    seen = set()\n",
        "    with open(judge_path) as f:\n",
        "        for line in f:\n",
        "            if line.strip():\n",
        "                r = json.loads(line)\n",
        "                seen.add(r.get(\"question_id\") or r.get(\"id\"))\n",
        "    return seen\n",
        "\n",
        "def get_all_questions():\n",
        "    questions = {}\n",
        "    with open(question_path) as f:\n",
        "        for line in f:\n",
        "            if line.strip():\n",
        "                r = json.loads(line)\n",
        "                questions[r[\"id\"]] = r\n",
        "    return questions\n",
        "\n",
        "def write_temp_questions(batch_ids, all_questions):\n",
        "    with open(temp_question_path, \"w\") as f:\n",
        "        for qid in batch_ids:\n",
        "            if qid in all_questions:\n",
        "                f.write(json.dumps(all_questions[qid]) + \"\\n\")\n",
        "    print(f\"Temp file written: {len(batch_ids)} questions\")\n",
        "\n",
        "def dedup_now():\n",
        "    if not os.path.exists(judge_path):\n",
        "        return 0\n",
        "    seen = set()\n",
        "    clean = []\n",
        "    with open(judge_path) as f:\n",
        "        for line in f:\n",
        "            if not line.strip(): continue\n",
        "            r = json.loads(line)\n",
        "            rid = r.get(\"question_id\") or r.get(\"id\")\n",
        "            if rid not in seen:\n",
        "                seen.add(rid)\n",
        "                clean.append(line)\n",
        "    with open(judge_path, \"w\") as f:\n",
        "        f.writelines(clean)\n",
        "    return len(clean)\n",
        "\n",
        "def backup(label):\n",
        "    shutil.copy(judge_path, os.path.join(backup_dir, f\"judgment_{label}.jsonl\"))\n",
        "    shutil.copy(judge_path, os.path.join(backup_dir, \"judgment_LATEST.jsonl\"))\n",
        "    print(f\"✅ Backed up: {label}\")\n",
        "\n",
        "# --- Config ---\n",
        "total_questions = 2037\n",
        "batch_size = 50\n",
        "batch_num = 0\n",
        "\n",
        "# Load all questions once\n",
        "all_questions = get_all_questions()\n",
        "all_ids = sorted(all_questions.keys())\n",
        "print(f\"Total questions loaded: {len(all_ids)}\")\n",
        "\n",
        "judged_ids = get_judged_ids()\n",
        "print(f\"Already judged: {len(judged_ids)}\")\n",
        "print(f\"Remaining: {total_questions - len(judged_ids)}\")\n",
        "print(f\"Estimated time at parallel=1: ~{(total_questions - len(judged_ids)) / 200:.1f} hours\")\n",
        "print(\"=\"*50)\n",
        "\n",
        "# --- Main loop ---\n",
        "while True:\n",
        "    judged_ids = get_judged_ids()\n",
        "    done = len(judged_ids)\n",
        "    remaining = total_questions - done\n",
        "\n",
        "    print(f\"\\n[Batch {batch_num+1}] Done: {done} | Remaining: {remaining} | {(done/total_questions)*100:.1f}%\")\n",
        "\n",
        "    if done >= total_questions:\n",
        "        print(\"\\n🎉 All 2037 records judged!\")\n",
        "        backup(f\"FINAL_{done}records\")\n",
        "        break\n",
        "\n",
        "    # Get ONLY unjudged IDs\n",
        "    unjudged = [qid for qid in all_ids if qid not in judged_ids]\n",
        "    batch_ids = unjudged[:batch_size]\n",
        "    print(f\"Judging IDs: {batch_ids[0]} → {batch_ids[-1]}\")\n",
        "\n",
        "    # Write only these IDs to temp file\n",
        "    write_temp_questions(batch_ids, all_questions)\n",
        "\n",
        "    # Run with parallel 1 - no race conditions\n",
        "    env = {**os.environ, \"SAFEDIAL_QUESTION_FILE\": temp_question_path}\n",
        "    result = subprocess.run(\n",
        "        [\"python\", \"gen_judgment.py\",\n",
        "         \"--bench-name\", \"SafeDial_bench\",\n",
        "         \"--judge-model\", \"gpt-3.5-turbo\",\n",
        "         \"--model-list\", \"Llama3.1-8B-Instruct\",\n",
        "         \"--mode\", \"single\",\n",
        "         \"--parallel\", \"1\",\n",
        "         \"--first-n\", str(batch_size)],\n",
        "        cwd=work_dir,\n",
        "        env=env\n",
        "    )\n",
        "\n",
        "    # Dedup after every batch\n",
        "    count = dedup_now()\n",
        "    batch_num += 1\n",
        "\n",
        "    print(f\"✅ After dedup: {count} unique records\")\n",
        "    print(f\"📊 Progress: {(count/total_questions)*100:.1f}%\")\n",
        "\n",
        "    # Backup every 5 batches\n",
        "    if batch_num % 5 == 0:\n",
        "        backup(f\"batch{batch_num}_{count}records\")\n",
        "\n",
        "    time.sleep(20)"
      ],
