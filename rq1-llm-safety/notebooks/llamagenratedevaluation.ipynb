        "# Load all questions once\n",
        "all_questions = get_all_questions()\n",
        "all_ids = sorted(all_questions.keys())\n",
        "print(f\"Total questions loaded: {len(all_ids)}\")\n",
        "\n",
        "judged_ids = get_judged_ids()\n",
        "print(f\"Already judged: {len(judged_ids)}\")\n",
        "print(f\"Remaining: {total_questions - len(judged_ids)}\")\n",
        "print(\"=\"*50)\n",
        "\n",
        "# --- Main loop ---\n",
        "while True:\n",
        "    judged_ids = get_judged_ids()\n",
        "    done = len(judged_ids)\n",
        "    remaining = total_questions - done\n",
        "\n",
        "    print(f\"\\n[Batch {batch_num+1}] Done: {done} | Remaining: {remaining} | {(done/total_questions)*100:.1f}%\")\n",
        "\n",
        "    if done >= total_questions:\n",
        "        print(\"\\n🎉 All 2037 records judged!\")\n",
        "        backup(f\"FINAL_{done}records\")\n",
        "        break\n",
        "\n",
        "    # Get ONLY unjudged IDs\n",
        "    unjudged = [qid for qid in all_ids if qid not in judged_ids]\n",
        "    batch_ids = unjudged[:batch_size]\n",
        "    print(f\"Judging IDs: {batch_ids[0]} → {batch_ids[-1]}\")\n",
        "\n",
        "    # Write only these IDs to temp file\n",
        "    write_temp_questions(batch_ids, all_questions)\n",
        "\n",
        "    # Run with parallel 1 - no race conditions\n",
        "    env = {**os.environ, \"SAFEDIAL_QUESTION_FILE\": temp_question_path}\n",
        "    result = subprocess.run(\n",
        "        [\"python\", \"gen_judgment.py\",\n",
        "         \"--bench-name\", \"SafeDial_bench\",\n",
        "         \"--judge-model\", \"gpt-3.5-turbo\",\n",
        "         \"--model-list\", \"Llama3.1-8B-Instruct\",\n",
        "         \"--mode\", \"single\",\n",
        "         \"--parallel\", \"1\",          # ← back to 1, no more race conditions\n",
        "         \"--first-n\", str(batch_size)],\n",
        "        cwd=work_dir,\n",
        "        env=env\n",
        "    )\n",
        "\n",
        "    # Dedup after every batch as safety net\n",
        "    count = dedup_now()\n",
        "    batch_num += 1\n",
        "\n",
        "    print(f\"✅ After dedup: {count} unique records\")\n",
        "    print(f\"📊 Progress: {(count/total_questions)*100:.1f}%\")\n",
        "\n",
        "    # Backup every 5 batches\n",
        "    if batch_num % 5 == 0:\n",
        "        backup(f\"batch{batch_num}_{count}records\")\n",
        "\n",
        "    time.sleep(20)"
      ],
