      "cell_type": "code",
      "source": [
        "import json, os, shutil, time, subprocess\n",
        "\n",
        "# Paths\n",
        "judge_path = \"/content/SafeDialBench-Dataset/FastChat/fastchat/llm_judge/data/SafeDial_bench/model_judgment/gpt-3.5-turbo_Llama3.1-8B-Instruct_en.jsonl\"\n",
        "answer_path = \"/content/SafeDialBench-Dataset/FastChat/fastchat/llm_judge/data/SafeDial_bench/model_answer/Llama3.1-8B-Instruct_en.jsonl\"\n",
        "question_path = \"/content/SafeDialBench-Dataset/FastChat/fastchat/llm_judge/data/SafeDial_bench/question_en.jsonl\"\n",
        "work_dir = \"/content/SafeDialBench-Dataset/FastChat/fastchat/llm_judge\"\n",
        "backup_dir = \"/content/drive/MyDrive/SafeDialBench_results\"\n",
        "os.makedirs(backup_dir, exist_ok=True)\n",
        "\n",
        "def get_judged_count():\n",
        "    if not os.path.exists(judge_path):\n",
        "        return 0\n",
        "    with open(judge_path) as f:\n",
        "        return sum(1 for l in f if l.strip())\n",
        "\n",
        "def backup(batch_num, judged):\n",
        "    dest = os.path.join(backup_dir, f\"judgment_backup_batch{batch_num}_{judged}records.jsonl\")\n",
        "    shutil.copy(judge_path, dest)\n",
        "    # Also overwrite the latest backup\n",
        "    shutil.copy(judge_path, os.path.join(backup_dir, \"judgment_LATEST.jsonl\"))\n",
        "    print(f\"  💾 Backed up to Drive — {judged} records saved\")\n",
        "\n",
        "def run_batch(first_n):\n",
        "    \"\"\"Run gen_judgment.py for first_n questions (already-judged ones are skipped by the patch)\"\"\"\n",
        "    result = subprocess.run(\n",
        "        [\"python\", \"gen_judgment.py\",\n",
        "         \"--bench-name\", \"SafeDial_bench\",\n",
        "         \"--judge-model\", \"gpt-3.5-turbo\",\n",
        "         \"--model-list\", \"Llama3.1-8B-Instruct\",\n",
        "         \"--mode\", \"single\",\n",
        "         \"--parallel\", \"1\",\n",
        "         \"--first-n\", str(first_n)],\n",
        "        cwd=work_dir\n",
        "    )\n",
        "    return result.returncode\n",
        "\n",
        "# --- Main loop ---\n",
        "total_questions = 2037\n",
        "batch_size = 100\n",
        "batch_num = 0\n",
        "\n",
        "print(f\"🚀 Starting evaluation of {total_questions} records\")\n",
        "print(f\"   Batch size: {batch_size} | Auto-backup after each batch\\n\")\n",
        "\n",
        "already_done = get_judged_count()\n",
        "if already_done > 0:\n",
        "    print(f\"▶️  Resuming from {already_done} already judged records\\n\")\n",
        "\n",
        "for target in range(batch_size, total_questions + batch_size, batch_size):\n",
        "    target = min(target, total_questions)\n",
        "    batch_num += 1\n",
        "\n",
        "    judged_before = get_judged_count()\n",
        "    if judged_before >= target:\n",
        "        print(f\"Batch {batch_num}: already done (target={target}), skipping\")\n",
        "        continue\n",
        "\n",
        "    print(f\"\\n{'='*50}\")\n",
        "    print(f\"Batch {batch_num}: running up to record {target}\")\n",
        "    print(f\"{'='*50}\")\n",
        "\n",
        "    returncode = run_batch(target)\n",
        "\n",
        "    judged_after = get_judged_count()\n",
        "    print(f\"\\n✅ Batch {batch_num} done — {judged_after} total records judged\")\n",
        "\n",
        "    backup(batch_num, judged_after)\n",
        "\n",
        "    if judged_after >= total_questions:\n",
        "        print(\"\\n🎉 All 2037 records evaluated!\")\n",
        "        break\n",
        "\n",
        "    # Small pause between batches to avoid rate limits\n",
        "    print(f\"⏳ Pausing 30s before next batch...\")\n",
        "    time.sleep(30)\n",
        "\n",
        "print(f\"\\n✅ Final count: {get_judged_count()} judgments saved\")\n",
        "print(f\"📁 All backups in: {backup_dir}\")"
      ],
