        "# CELL 5 (FIXED): Load Nemotron in 4-bit properly\n",
        "from transformers import AutoTokenizer, AutoModelForCausalLM, BitsAndBytesConfig\n",
        "import torch\n",
        "\n",
        "# Clear any partial downloads\n",
        "torch.cuda.empty_cache()\n",
        "\n",
        "NEMOTRON_ID = \"nvidia/Llama-3.1-Nemotron-Safety-Guard-8B-v3\"\n",
        "\n",
        "bnb_config = BitsAndBytesConfig(\n",
        "    load_in_4bit=True,\n",
        "    bnb_4bit_use_double_quant=True,\n",
        "    bnb_4bit_quant_type=\"nf4\",\n",
        "    bnb_4bit_compute_dtype=torch.bfloat16\n",
        ")\n",
        "\n",
        "print(\"Loading Nemotron tokenizer...\")\n",
        "nemotron_tok = AutoTokenizer.from_pretrained(NEMOTRON_ID)\n",
        "print(\"Tokenizer done.\")\n",
        "\n",
        "print(\"Loading Nemotron model in 4-bit...\")\n",
        "nemotron_model = AutoModelForCausalLM.from_pretrained(\n",
        "    NEMOTRON_ID,\n",
        "    quantization_config=bnb_config,\n",
        "    device_map=\"auto\",\n",
        "    torch_dtype=torch.bfloat16,\n",
