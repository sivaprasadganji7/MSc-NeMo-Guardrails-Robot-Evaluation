        "import json, os, shutil\n",
        "from tqdm import tqdm\n",
        "from google.colab import drive\n",
        "drive.mount('/content/drive')\n",
        "\n",
        "output_path = \"Llama3.1-8B-Instruct_en_output_classified.jsonl\"\n",
        "backup_dir = \"/content/drive/MyDrive/SafeDialBench_results\"\n",
        "os.makedirs(backup_dir, exist_ok=True)\n",
        "\n",
        "# Resume support\n",
        "processed_ids = set()\n",
        "if os.path.exists(output_path):\n",
        "    with open(output_path) as f:\n",
        "        for line in f:\n",
        "            if line.strip():\n",
        "                processed_ids.add(json.loads(line)[\"id\"])\n",
        "    print(f\"Resuming — already processed: {len(processed_ids)}\")\n",
        "else:\n",
        "    print(\"Starting fresh\")\n",
        "\n",
        "remaining = [r for r in filtered_judgments if r[\"id\"] not in processed_ids]\n",
        "print(f\"Records to classify: {len(remaining)}\")\n",
        "print(f\"Estimated time: ~{len(remaining) * 15 / 3600:.1f} hours\")\n",
        "\n",
        "safe_count = 0\n",
        "unsafe_count = 0\n",
        "error_count = 0\n",
        "\n",
        "with open(output_path, \"a\") as out_f:\n",
        "    for i, record in enumerate(tqdm(remaining)):\n",
        "        try:\n",
        "            turn_results, dialogue_unsafe = classify_dialogue_turns(record)\n",
        "\n",
        "            result = dict(record)\n",
        "            result[\"nemotron_turn_results\"]    = turn_results\n",
        "            result[\"nemotron_dialogue_unsafe\"] = dialogue_unsafe\n",
        "            result[\"output_safe\"]              = not dialogue_unsafe\n",
        "            result[\"nemotron_all_categories\"]  = list(set(\n",
        "                cat for t in turn_results for cat in t.get(\"categories\", [])\n",
        "            ))\n",
        "\n",
        "            out_f.write(json.dumps(result) + \"\\n\")\n",
        "            out_f.flush()\n",
        "\n",
        "            if dialogue_unsafe:\n",
        "                unsafe_count += 1\n",
        "            else:\n",
        "                safe_count += 1\n",
        "\n",
        "        except Exception as e:\n",
        "            error_count += 1\n",
        "            result = dict(record)\n",
        "            result[\"nemotron_error\"]           = str(e)\n",
        "            result[\"nemotron_dialogue_unsafe\"] = None\n",
        "            result[\"output_safe\"]              = None\n",
        "            out_f.write(json.dumps(result) + \"\\n\")\n",
        "            out_f.flush()\n",
        "\n",
        "        # Progress + backup every 100 records\n",
        "        if (i + 1) % 100 == 0:\n",
        "            shutil.copy(output_path, f\"{backup_dir}/output_classified_LATEST.jsonl\")\n",
        "            print(f\"\\n[{i+1}/{len(remaining)}] Safe: {safe_count} | Unsafe: {unsafe_count} | Errors: {error_count}\")\n",
        "\n",
        "# Final stats\n",
        "total = safe_count + unsafe_count + error_count\n",
        "print(\"\\n\" + \"=\"*50)\n",
        "print(f\"DONE!\")\n",
        "print(f\"Total processed  : {total}\")\n",
        "print(f\"Safe responses   : {safe_count}  ({safe_count/total*100:.1f}%)\")\n",
        "print(f\"Unsafe responses : {unsafe_count}  ({unsafe_count/total*100:.1f}%)\")\n",
        "print(f\"Errors           : {error_count}\")\n",
        "print(f\"\\nOutput ASR       : {unsafe_count/(safe_count+unsafe_count)*100:.1f}%\")\n",
        "print(f\"\\nFull pipeline summary:\")\n",
        "print(f\"  Original dialogues      : 2037\")\n",
        "print(f\"  After input filter      : 1269  (removed {2037-1269} blocked inputs)\")\n",
        "print(f\"  After output filter     : {safe_count}  (removed {unsafe_count} unsafe responses)\")\n",
        "print(f\"  Final safe dialogues    : {safe_count}\")\n",
        "print(f\"  Total ASR (both filters): {(2037-safe_count)/2037*100:.1f}%\")\n",
        "\n",
        "shutil.copy(output_path, f\"{backup_dir}/output_classified_FINAL.jsonl\")\n",
        "print(\"\\n✅ Final backup saved to Drive\")"
      ]
    }
  ],
