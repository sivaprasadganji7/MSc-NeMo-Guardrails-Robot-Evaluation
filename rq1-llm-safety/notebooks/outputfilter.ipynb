      "source": [
        "# Test per-turn classification on first 2 records\n",
        "print(\"Testing per-turn classification...\\n\")\n",
        "\n",
        "def extract_last_assistant_response(conversation_context):\n",
        "    \"\"\"Extract only the last assistant response from conversation context\"\"\"\n",
        "    parts = conversation_context.split(\"assistant：\")\n",
        "    if len(parts) < 2:\n",
        "        parts = conversation_context.split(\"assistant:\")\n",
        "    if len(parts) >= 2:\n",
        "        # Get last assistant response, stop at next user turn\n",
        "        last_response = parts[-1].split(\"user：\")[0].split(\"user:\")[0].strip()\n",
        "        return last_response\n",
        "    return conversation_context.strip()\n",
        "\n",
        "def classify_dialogue_turns(record):\n",
        "    \"\"\"Classify each turn's assistant response\"\"\"\n",
        "    rounds = record.get(\"rounds_info\", [])\n",
        "    turn_results = []\n",
        "    dialogue_unsafe = False\n",
        "\n",
        "    for round_info in rounds:\n",
        "        round_num = round_info.get(\"round\")\n",
        "        context = round_info.get(\"conversation_context\", \"\")\n",
        "\n",
        "        # Extract assistant response for this turn\n",
        "        assistant_response = extract_last_assistant_response(context)\n",
        "\n",
        "        if not assistant_response:\n",
        "            continue\n",
        "\n",
        "        _, response_unsafe, categories, raw = check_with_nemotron(\n",
        "            user_turns=[\"\"],\n",
        "            assistant_response=assistant_response[:800]  # truncate to save VRAM\n",
        "        )\n",
        "\n",
        "        turn_results.append({\n",
        "            \"round\": round_num,\n",
        "            \"response_unsafe\": response_unsafe,\n",
        "            \"categories\": categories,\n",
        "            \"raw\": raw\n",
        "        })\n",
        "\n",
        "        if response_unsafe:\n",
        "            dialogue_unsafe = True\n",
        "\n",
        "    return turn_results, dialogue_unsafe\n",
        "\n",
        "# Test on first 2 records\n",
        "for i, record in enumerate(filtered_judgments[:2]):\n",
        "    print(f\"=== Record {i+1} | ID={record['id']} | Task={record['task']} | Method={record['method']} ===\")\n",
        "    turn_results, dialogue_unsafe = classify_dialogue_turns(record)\n",
        "\n",
        "    for t in turn_results:\n",
        "        status = \"❌ UNSAFE\" if t[\"response_unsafe\"] else \"✅ safe\"\n",
        "        print(f\"  Turn {t['round']}: {status} | cats={t['categories']}\")\n",
        "        print(f\"           raw: {t['raw']}\")\n",
        "\n",
        "    print(f\"  → Dialogue unsafe: {dialogue_unsafe}\")\n",
        "    print()"
      ]
    },
