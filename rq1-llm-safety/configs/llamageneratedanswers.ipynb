        "import json\n",
        "import torch\n",
        "\n",
        "with open(\"cleaned_en.json\", \"r\", encoding=\"utf-8\") as f:\n",
        "    data = json.load(f)\n",
        "\n",
        "# Pick 2 entries with 5 turns\n",
        "test_entries = [e for e in data if e[\"num_turns\"] == 5][:2]\n",
        "\n",
        "tokenizer.pad_token = tokenizer.eos_token\n",
        "tokenizer.padding_side = \"left\"\n",
        "\n",
        "def batch_generate(messages_list):\n",
        "    all_input_ids = []\n",
        "    for msgs in messages_list:\n",
        "        encoded = tokenizer.apply_chat_template(\n",
        "            msgs, tokenize=True, add_generation_prompt=True,\n",
        "            return_dict=True, return_tensors=\"pt\"\n",
        "        )\n",
        "        all_input_ids.append(encoded[\"input_ids\"][0])\n",
        "\n",
        "    max_len = max(ids.shape[0] for ids in all_input_ids)\n",
        "    padded_ids = []\n",
        "    attention_masks = []\n",
        "\n",
        "    for ids in all_input_ids:\n",
        "        pad_len = max_len - ids.shape[0]\n",
        "        padded_ids.append(torch.cat([\n",
        "            torch.full((pad_len,), tokenizer.pad_token_id, dtype=ids.dtype), ids\n",
        "        ]))\n",
        "        attention_masks.append(torch.cat([\n",
        "            torch.zeros(pad_len, dtype=torch.long),\n",
        "            torch.ones(ids.shape[0], dtype=torch.long)\n",
        "        ]))\n",
        "\n",
        "    input_ids = torch.stack(padded_ids).to(model.device)\n",
        "    attention_mask = torch.stack(attention_masks).to(model.device)\n",
        "\n",
        "    with torch.no_grad():\n",
        "        outputs = model.generate(\n",
        "            input_ids=input_ids,\n",
        "            attention_mask=attention_mask,\n",
        "            max_new_tokens=512,\n",
        "            do_sample=False,\n",
        "            pad_token_id=tokenizer.eos_token_id\n",
        "        )\n",
        "\n",
        "    responses = []\n",
        "    for out in outputs:\n",
        "        responses.append(tokenizer.decode(out[max_len:], skip_special_tokens=True))\n",
        "    return responses\n",
        "\n",
        "# Run full multi-turn for 2 entries\n",
        "batch_messages = [[] for _ in test_entries]\n",
        "batch_responses = [[] for _ in test_entries]\n",
        "\n",
        "for turn_idx in range(5):\n",
        "    print(f\"\\n{'='*50}\")\n",
        "    print(f\"TURN {turn_idx + 1}\")\n",
        "    print(f\"{'='*50}\")\n",
        "\n",
        "    for i, entry in enumerate(test_entries):\n",
        "        batch_messages[i].append({\"role\": \"user\", \"content\": entry[\"user_turns\"][turn_idx]})\n",
        "        print(f\"\\n[Dialogue {entry['id']}] USER: {entry['user_turns'][turn_idx][:80]}\")\n",
        "\n",
        "    responses = batch_generate(batch_messages)\n",
        "\n",
        "    for i, resp in enumerate(responses):\n",
        "        batch_responses[i].append(resp)\n",
        "        batch_messages[i].append({\"role\": \"assistant\", \"content\": resp})\n",
        "        print(f\"[Dialogue {test_entries[i]['id']}] LLAMA: {resp[:80]}\")\n",
        "\n",
        "# Verify output format\n",
        "print(f\"\\n\\n{'='*50}\")\n",
        "print(\"OUTPUT VERIFICATION\")\n",
        "print(f\"{'='*50}\")\n",
        "for i, entry in enumerate(test_entries):\n",
        "    print(f\"\\nDialogue {entry['id']}: {len(batch_responses[i])} responses for {entry['num_turns']} turns\")\n",
        "    for t, (u, b) in enumerate(zip(entry[\"user_turns\"], batch_responses[i])):\n",
        "        print(f\"  Turn {t+1} USER: {u[:60]}\")\n",
        "        print(f\"  Turn {t+1} BOT:  {b[:60]}\")\n",
        "        print()"
      ]
