      "source": [
        "import json\n",
        "import time\n",
        "import torch\n",
        "import os\n",
        "from collections import defaultdict\n",
        "from google.colab import drive\n",
        "\n",
        "drive.mount('/content/drive')\n",
        "\n",
        "PROJECT_DIR = \"/content/drive/MyDrive/SafeDialBench\"\n",
        "INPUT_FILE = \"cleaned_en.json\"\n",
        "OUTPUT_FILE = f\"{PROJECT_DIR}/llama31_8b_full_multiturn_en.jsonl\"\n",
        "BATCH_SIZE = 8\n",
        "MAX_NEW_TOKENS = 1024\n",
        "\n",
        "tokenizer.pad_token = tokenizer.eos_token\n",
        "tokenizer.padding_side = \"left\"\n",
        "\n",
        "with open(INPUT_FILE, \"r\", encoding=\"utf-8\") as f:\n",
        "    data = json.load(f)\n",
        "\n",
        "# === RESUME CHECK ===\n",
        "completed_ids = set()\n",
        "if os.path.exists(OUTPUT_FILE):\n",
        "    with open(OUTPUT_FILE, \"r\", encoding=\"utf-8\") as f:\n",
        "        for line in f:\n",
        "            if line.strip():\n",
        "                try:\n",
        "                    completed_ids.add(json.loads(line)[\"id\"])\n",
        "                except:\n",
        "                    pass\n",
        "    print(f\"RESUMING: {len(completed_ids)} already done\")\n",
        "\n",
        "remaining = [e for e in data if e[\"id\"] not in completed_ids]\n",
        "print(f\"Total: {len(data)} | Done: {len(completed_ids)} | Remaining: {len(remaining)}\")\n",
        "\n",
        "if len(remaining) == 0:\n",
        "    print(\"ALL DONE!\")\n",
        "\n",
        "# Group by num_turns\n",
        "groups = defaultdict(list)\n",
        "for e in remaining:\n",
        "    groups[e[\"num_turns\"]].append(e)\n",
        "\n",
        "print(\"\\nRemaining by turn count:\")\n",
        "for k in sorted(groups.keys()):\n",
        "    print(f\"  {k} turns: {len(groups[k])} dialogues\")\n",
        "\n",
        "def batch_generate(messages_list):\n",
        "    all_input_ids = []\n",
        "    for msgs in messages_list:\n",
        "        encoded = tokenizer.apply_chat_template(\n",
        "            msgs, tokenize=True, add_generation_prompt=True,\n",
        "            return_dict=True, return_tensors=\"pt\"\n",
        "        )\n",
        "        all_input_ids.append(encoded[\"input_ids\"][0])\n",
        "\n",
        "    max_len = max(ids.shape[0] for ids in all_input_ids)\n",
        "    padded_ids = []\n",
        "    attention_masks = []\n",
        "\n",
        "    for ids in all_input_ids:\n",
        "        pad_len = max_len - ids.shape[0]\n",
        "        padded_ids.append(torch.cat([\n",
        "            torch.full((pad_len,), tokenizer.pad_token_id, dtype=ids.dtype), ids\n",
        "        ]))\n",
        "        attention_masks.append(torch.cat([\n",
        "            torch.zeros(pad_len, dtype=torch.long),\n",
        "            torch.ones(ids.shape[0], dtype=torch.long)\n",
        "        ]))\n",
        "\n",
        "    input_ids = torch.stack(padded_ids).to(model.device)\n",
        "    attention_mask = torch.stack(attention_masks).to(model.device)\n",
        "\n",
        "    with torch.no_grad():\n",
        "        outputs = model.generate(\n",
        "            input_ids=input_ids,\n",
        "            attention_mask=attention_mask,\n",
        "            max_new_tokens=MAX_NEW_TOKENS,\n",
        "            do_sample=False,\n",
        "            pad_token_id=tokenizer.eos_token_id\n",
        "        )\n",
        "\n",
        "    responses = []\n",
        "    for out in outputs:\n",
        "        responses.append(tokenizer.decode(out[max_len:], skip_special_tokens=True))\n",
        "    return responses\n",
        "\n",
        "def single_generate(entry):\n",
        "    messages = []\n",
        "    responses = []\n",
        "    for user_msg in entry[\"user_turns\"]:\n",
        "        messages.append({\"role\": \"user\", \"content\": user_msg})\n",
        "        inputs = tokenizer.apply_chat_template(\n",
        "            messages, return_tensors=\"pt\", tokenize=True,\n",
        "            add_generation_prompt=True, return_dict=True\n",
        "        )\n",
        "        input_ids = inputs[\"input_ids\"].to(model.device)\n",
        "        attention_mask = inputs[\"attention_mask\"].to(model.device)\n",
        "        with torch.no_grad():\n",
        "            output = model.generate(\n",
        "                input_ids=input_ids,\n",
        "                attention_mask=attention_mask,\n",
        "                max_new_tokens=MAX_NEW_TOKENS,\n",
        "                do_sample=False,\n",
        "                pad_token_id=tokenizer.eos_token_id\n",
        "            )\n",
        "        resp = tokenizer.decode(output[0][input_ids.shape[1]:], skip_special_tokens=True)\n",
        "        responses.append(resp)\n",
        "        messages.append({\"role\": \"assistant\", \"content\": resp})\n",
        "    return responses\n",
        "\n",
        "# === MAIN LOOP ===\n",
        "start_time = time.time()\n",
        "total_done = 0\n",
        "errors = []\n",
        "\n",
        "with open(OUTPUT_FILE, \"a\", encoding=\"utf-8\") as out_f:\n",
        "    for num_turns in sorted(groups.keys()):\n",
        "        group = groups[num_turns]\n",
        "        print(f\"\\n=== {len(group)} dialogues with {num_turns} turns ===\")\n",
        "\n",
        "        for batch_start in range(0, len(group), BATCH_SIZE):\n",
        "            batch = group[batch_start:batch_start + BATCH_SIZE]\n",
        "\n",
        "            try:\n",
        "                batch_messages = [[] for _ in batch]\n",
        "                batch_responses = [[] for _ in batch]\n",
        "\n",
        "                for turn_idx in range(num_turns):\n",
        "                    for i, entry in enumerate(batch):\n",
        "                        batch_messages[i].append({\n",
        "                            \"role\": \"user\",\n",
        "                            \"content\": entry[\"user_turns\"][turn_idx]\n",
        "                        })\n",
        "\n",
        "                    # Check context length\n",
        "                    too_long = False\n",
        "                    for msgs in batch_messages:\n",
        "                        test = tokenizer.apply_chat_template(\n",
        "                            msgs, tokenize=True, return_dict=True,\n",
        "                            add_generation_prompt=True, return_tensors=\"pt\"\n",
        "                        )\n",
        "                        if test[\"input_ids\"].shape[1] > 7000:\n",
        "                            too_long = True\n",
        "                            break\n",
        "\n",
        "                    if too_long:\n",
        "                        for i in range(len(batch)):\n",
        "                            batch_responses[i].append(\"[SKIPPED: context too long]\")\n",
        "                            batch_messages[i].append({\n",
        "                                \"role\": \"assistant\",\n",
        "                                \"content\": \"I cannot respond to this.\"\n",
        "                            })\n",
        "                        continue\n",
        "\n",
        "                    responses = batch_generate(batch_messages)\n",
        "\n",
        "                    for i, resp in enumerate(responses):\n",
        "                        batch_responses[i].append(resp)\n",
        "                        batch_messages[i].append({\n",
        "                            \"role\": \"assistant\", \"content\": resp\n",
        "                        })\n",
        "\n",
        "                for i, entry in enumerate(batch):\n",
        "                    result = {\n",
        "                        \"task\": entry[\"task\"],\n",
        "                        \"method\": entry[\"method\"],\n",
        "                        \"model_type\": \"Llama3.1-8B-Instruct\",\n",
        "                        \"scene\": entry[\"scene\"],\n",
        "                        \"id\": entry[\"id\"],\n",
        "                        \"history\": [\n",
        "                            {\"user\": u, \"bot\": b}\n",
        "                            for u, b in zip(entry[\"user_turns\"], batch_responses[i])\n",
        "                        ]\n",
        "                    }\n",
        "                    out_f.write(json.dumps(result, ensure_ascii=False) + \"\\n\")\n",
        "                    total_done += 1\n",
        "\n",
        "                out_f.flush()\n",
        "                os.fsync(out_f.fileno())\n",
        "                elapsed = time.time() - start_time\n",
        "                rate = total_done / elapsed\n",
        "                eta = (len(remaining) - total_done) / rate / 60 if rate > 0 else 0\n",
        "                print(f\"  [{total_done}/{len(remaining)}] \"\n",
        "                      f\"{rate:.2f} dial/s | ETA: {eta:.0f} min | \"\n",
        "                      f\"GPU: {torch.cuda.memory_allocated(0)/1024**3:.1f}GB\")\n",
        "\n",
        "            except torch.cuda.OutOfMemoryError:\n",
        "                print(f\"  OOM! Falling back to sequential...\")\n",
        "                torch.cuda.empty_cache()\n",
        "                for entry in batch:\n",
        "                    if entry[\"id\"] in completed_ids:\n",
        "                        continue\n",
        "                    try:\n",
        "                        responses = single_generate(entry)\n",
        "                        result = {\n",
        "                            \"task\": entry[\"task\"],\n",
        "                            \"method\": entry[\"method\"],\n",
        "                            \"model_type\": \"Llama3.1-8B-Instruct\",\n",
        "                            \"scene\": entry[\"scene\"],\n",
        "                            \"id\": entry[\"id\"],\n",
        "                            \"history\": [\n",
        "                                {\"user\": u, \"bot\": b}\n",
        "                                for u, b in zip(entry[\"user_turns\"], responses)\n",
        "                            ]\n",
        "                        }\n",
        "                        out_f.write(json.dumps(result, ensure_ascii=False) + \"\\n\")\n",
        "                        out_f.flush()\n",
        "                        total_done += 1\n",
        "                    except Exception as e:\n",
        "                        print(f\"    Error ID {entry['id']}: {e}\")\n",
        "                        errors.append(entry[\"id\"])\n",
        "                        torch.cuda.empty_cache()\n",
        "\n",
        "            except Exception as e:\n",
        "                print(f\"  Error: {e}\")\n",
        "                for entry in batch:\n",
        "                    errors.append(entry[\"id\"])\n",
        "\n",
        "elapsed = time.time() - start_time\n",
        "print(f\"\\n{'='*50}\")\n",
        "print(f\"DONE! Time: {elapsed/60:.1f} min ({elapsed/3600:.1f} hrs)\")\n",
        "print(f\"Generated: {total_done} | Errors: {len(errors)}\")\n",
        "if errors:\n",
        "    print(f\"Error IDs: {errors[:20]}\")\n",
        "print(f\"File: {OUTPUT_FILE}\")\n",
        "\n",
        "count = 0\n",
        "with open(OUTPUT_FILE, \"r\", encoding=\"utf-8\") as f:\n",
        "    for line in f:\n",
        "        if line.strip():\n",
        "            count += 1\n",
        "print(f\"Verified: {count} / {len(data)}\")"
      ]
    },
