        "import json\n",
        "import torch\n",
        "\n",
        "with open(\"cleaned_en.json\", \"r\", encoding=\"utf-8\") as f:\n",
        "    data = json.load(f)\n",
        "\n",
        "entry = data[0]\n",
        "print(f\"ID: {entry['id']}, Task: {entry['task']}, Method: {entry['method']}\")\n",
        "print(f\"Turns: {entry['num_turns']}\")\n",
        "\n",
        "# Generate Llama response for EVERY turn\n",
        "messages = []\n",
        "all_responses = []\n",
        "\n",
        "for turn_idx, user_msg in enumerate(entry[\"user_turns\"]):\n",
        "    print(f\"\\n--- Turn {turn_idx + 1} ---\")\n",
        "    print(f\"USER: {user_msg}\")\n",
        "\n",
        "    # Add user message\n",
        "    messages.append({\"role\": \"user\", \"content\": user_msg})\n",
        "\n",
        "    # Tokenize full conversation so far\n",
        "    inputs = tokenizer.apply_chat_template(\n",
        "        messages,\n",
        "        return_tensors=\"pt\",\n",
        "        tokenize=True,\n",
        "        add_generation_prompt=True,\n",
        "        return_dict=True\n",
        "    )\n",
        "    input_ids = inputs[\"input_ids\"].to(model.device)\n",
        "    attention_mask = inputs[\"attention_mask\"].to(model.device)\n",
        "\n",
        "    # Generate\n",
        "    with torch.no_grad():\n",
        "        output = model.generate(\n",
        "            input_ids=input_ids,\n",
        "            attention_mask=attention_mask,\n",
        "            max_new_tokens=1024,\n",
        "            do_sample=False,\n",
        "            pad_token_id=tokenizer.eos_token_id\n",
        "        )\n",
        "\n",
        "    response = tokenizer.decode(output[0][input_ids.shape[1]:], skip_special_tokens=True)\n",
        "    all_responses.append(response)\n",
        "\n",
        "    # Add assistant response to conversation history for next turn\n",
        "    messages.append({\"role\": \"assistant\", \"content\": response})\n",
        "\n",
        "    print(f\"LLAMA: {response[:200]}\")\n",
        "\n",
        "# Build output in paper format\n",
        "output_entry = {\n",
        "    \"task\": entry[\"task\"],\n",
        "    \"method\": entry[\"method\"],\n",
        "    \"model_type\": \"Llama3.1-8B-Instruct\",\n",
        "    \"scene\": entry[\"scene\"],\n",
        "    \"id\": entry[\"id\"],\n",
        "    \"history\": [\n",
        "        {\"user\": u, \"bot\": b}\n",
        "        for u, b in zip(entry[\"user_turns\"], all_responses)\n",
        "    ]\n",
        "}\n",
        "\n",
        "print(f\"\\n\\n=== OUTPUT FORMAT ===\")\n",
        "print(json.dumps(output_entry, indent=2, ensure_ascii=False)[:2000])"
      ]
